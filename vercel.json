{
  "version": 2,
  "outputDirectory": "src/main/resources/static",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://memorychat-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/auth/script.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/chat/script.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/runtime-config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
